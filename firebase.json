{
  "hosting": {
    "site": "inkline-1234",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "scripts/**",
      "README.md",
      "firestore.rules"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|webmanifest)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
